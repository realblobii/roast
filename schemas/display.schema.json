{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roast display (data/<ns>/recipe/<name>.json)",
  "type": "object",
  "required": [
    "type",
    "block"
  ],
  "properties": {
    "type": {
      "const": "roast:display"
    },
    "block": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ":"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": ":"
          }
        }
      ]
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offset": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scale": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 4
    },
    "rotation": {
      "type": "number"
    },
    "lay_flat": {
      "type": "boolean",
      "default": true
    },
    "sound": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    }
  }
}
