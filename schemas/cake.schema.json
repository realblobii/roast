{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roast cake (data/<ns>/recipe/<name>.json)",
  "type": "object",
  "required": [
    "type",
    "block"
  ],
  "properties": {
    "type": {
      "const": "roast:cake"
    },
    "block": {
      "oneOf": [
        {
          "type": "string",
          "pattern": ":"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": ":"
          }
        }
      ]
    },
    "property": {
      "type": "string",
      "default": "bites"
    },
    "max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 6
    },
    "nutrition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "saturation": {
      "type": "number",
      "minimum": 0
    },
    "saturation_modifier": {
      "type": "number",
      "minimum": 0
    },
    "always_edible": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "amplifier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "leave": {
      "type": "string",
      "pattern": ":"
    },
    "sound": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "slice_tool": {
      "type": "string"
    },
    "slice_item": {
      "type": "string",
      "pattern": ":"
    }
  }
}
